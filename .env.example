# Supabase (get from: https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT Secret (any random string, keep secret)
JWT_SECRET=sqas_super_secret_jwt_key_2026

# Resend — used to email OTP codes during student login
# Sign up free at https://resend.com → API Keys → create one (3,000 emails/month free)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Use the default sandbox sender for testing, or your verified domain in production
# Format: "Display Name <address@domain.com>"
EMAIL_FROM=SQAS <onboarding@resend.dev>
